{
  "format_on_save": "on",
  "proxy": "",
  "ui_font_family": ".ZedMono",
  "session": {
    "trust_all_worktrees": false,
  },
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "buffer_font_fallbacks": [".ZedMono"],
  "buffer_font_family": "Hack Nerd Font Mono",
  "base_keymap": "JetBrains",
  "ensure_final_newline_on_save": true,
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "journal": {
    "hour_format": "hour24",
  },
  "auto_update": false,
  "theme": "Tokyo Night",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 16.0,
}
